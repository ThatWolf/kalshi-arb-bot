# ── Kalshi credentials ───────────────────────────────────────────────────────
# Sign up at https://kalshi.com and use the email/password you log in with.
KALSHI_EMAIL=your_email@example.com
KALSHI_PASSWORD=your_kalshi_password

# ── The Odds API ─────────────────────────────────────────────────────────────
# Get a free key at https://the-odds-api.com (500 req/month on free tier).
THE_ODDS_API_KEY=your_odds_api_key_here

# ── Bot settings (optional) ───────────────────────────────────────────────────
# Total bankroll in USD used for stake-size calculations.
BANKROLL=1000

# Markets within this implied-probability total are shown as near-misses.
# 1.05 = within 5% of a true arbitrage.
NEAR_MISS_THRESHOLD=1.05
