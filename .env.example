# ── The Odds API ─────────────────────────────────────────────────────────────
# Get a free key at https://the-odds-api.com (500 req/month on free tier).
# Kalshi market data is fully public — no Kalshi credentials required.
THE_ODDS_API_KEY=your_odds_api_key_here

# ── Bot settings (optional) ───────────────────────────────────────────────────
BANKROLL=1000
NEAR_MISS_THRESHOLD=1.05

# Kalshi quadratic fee cap (default 7% — check your account tier at kalshi.com/fees)
KALSHI_MAX_FEE=0.07
